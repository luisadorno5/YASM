{
  "ApplicationDefaults": {
    "ExecutablePath": "%ProgramFiles%\\nodejs\\node.exe",
    "Arguments": "server.js",
    "ShutdownTimeout": "0.00:00:10",
    "VersionArguments": "--version",
    "AutoStart": true,
    "OutputBufferLines": 500,
    "EnvironmentVariables": {
      "NODE_ENV": "production",
      "HOSTNAME": "0.0.0.0"
    },
    "RestartPolicy": {
      "InitialDelay": "0.00:00:02",
      "MaxDelay": "0.00:01:00",
      "MaxRestarts": 5,
      "RestartWindow": "0.00:10:00"
    },
    "HealthCheck": {
      "Enabled": false,
      "StartupTimeout": "0.00:01:00",
      "RetryInterval": "0.00:00:02",
      "RequestTimeout": "0.00:00:05"
    }
  },
  "Applications": {
    "storefront": {
      "WorkingDirectory": "..\\apps\\storefront",
      "EnvironmentVariables": {
        "PORT": "3000"
      },
      "PreflightPort": 3000,
      "HealthCheck": {
        "Enabled": true,
        "Url": "http://127.0.0.1:3000/api/health"
      }
    },
    "admin": {
      "WorkingDirectory": "..\\apps\\admin",
      "EnvironmentVariables": {
        "PORT": "3001"
      },
      "PreflightPort": 3001,
      "AutoStart": false
    }
  },
  "ControlApi": {
    "Url": "http://127.0.0.1:5080"
  },
  "ENABLE_CONSOLE_LOGGING": false,
  "SerilogOptions": {
    "LogDirectory": "C:\\Logs\\service-wrapper",
    "MinimumLevel": "Information",
    "RetainedFileCountLimit": 31,
    "FileSizeLimitBytes": 104857600,
    "CrashContextLines": 50
  },
  "StateFile": "state.json"
}
